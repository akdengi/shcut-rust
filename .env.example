# ShCut Rust Configuration

# Server
HOST=0.0.0.0
PORT=5231

# Database
DATABASE_URL=/app/data/shcut.db

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Admin credentials (optional - seed admin user on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
ADMIN_NICKNAME=admin

# Registration control (false = only admin can create users)
ALLOW_REGISTRATION=false

# App URL (used in password reset links)
APP_URL=https://invapi.online

# SMTP (optional - required for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# Logging
RUST_LOG=shcut_rust=info,tower_http=info
